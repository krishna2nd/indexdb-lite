# NPM Configuration for @krk namespace publishing
# 
# To use this configuration:
# 1. Make sure you're logged in to npm: npm login
# 2. Verify your scope is registered: npm whoami --registry https://registry.npmjs.org/
# 3. Run: npm publish --access public
#
# Note: Your npm account must have permission to publish to @krk scope

# Registry for the @krk scope (uses default registry)
@krk:registry=https://registry.npmjs.org/

# Always use exact versions for dependencies (remove the ^ prefix during publish)
save-exact=false

# Log level
loglevel=warn

# Ensure public access for scoped packages
access=public
