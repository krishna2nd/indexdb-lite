.PHONY : storage/src/in_memory_storage.i

# target to preprocess a source file
storage/src/in_memory_storage.cc.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/local_indexed_db.dir/build.make CMakeFiles/local_indexed_db.dir/storage/src/in_memory_storage.cc.i
.PHONY : storage/src/in_memory_storage.cc.i

