.PHONY : storage/src/in_memory_storage.s

# target to generate assembly for a file
storage/src/in_memory_storage.cc.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/local_indexed_db.dir/build.make CMakeFiles/local_indexed_db.dir/storage/src/in_memory_storage.cc.s
.PHONY : storage/src/in_memory_storage.cc.s

